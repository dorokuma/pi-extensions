{
  "//": "类型检查配置说明见 README『类型检查』节与 .agents/notes/20261004-pi-extensions-repo-init.md。herdsman-bridge 是跨仓再导出壳，目标源码在 /root/workspace/herdsman（受铁律保护、不得触碰），由 herdr/herdsman 仓自身 tsconfig 负责其类型正确性，故不纳入本仓 tsc 图（见 include 范围与实际 tsc 输出）。",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "extensions/auto-continue/src/**/*.ts",
    "extensions/no-tables/src/**/*.ts",
    "extensions/prism/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "extensions/herdsman-bridge/src/**"
  ]
}
